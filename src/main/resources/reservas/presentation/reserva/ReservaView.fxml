<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <top>
        <VBox spacing="5">
            <HBox spacing="10">
                <TextField fx:id="txtFrase"
                           promptText="Describí la reserva (ej: reunión mañana de 9 a 11, necesito sala y proyector)"
                           HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnExtraer" text="Extraer con IA"/>
            </HBox>
            <TextField fx:id="txtActividad" promptText="Actividad"/>
            <DatePicker fx:id="dpFecha"/>
            <ComboBox fx:id="cmbHoraInicio" promptText="Hora inicio"/>
            <ComboBox fx:id="cmbHoraFin" promptText="Hora fin"/>
            <ListView fx:id="listCategorias"/>
            <HBox spacing="10">
                <Button fx:id="btnReservar" text="Reservar"/>
                <Button fx:id="btnCancelar" text="Cancelar reserva seleccionada"/>
                <Button fx:id="btnLimpiar" text="Limpiar"/>
                <Button fx:id="btnPdf" text="Generar PDF"/>
            </HBox>
            <Label fx:id="lblError" style="-fx-text-fill: red;"/>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tablaReservas">
            <columns>
                <TableColumn fx:id="colActividad" text="Actividad"/>
                <TableColumn fx:id="colFecha" text="Fecha"/>
                <TableColumn fx:id="colHorario" text="Horario"/>
                <TableColumn fx:id="colEstado" text="Estado"/>
            </columns>
        </TableView>
    </center>
</BorderPane>